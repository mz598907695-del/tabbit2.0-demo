    "浏览器界面与页面内容"
  ],
  "nativeGlass": "固定系统标准玻璃；主题色及浓度不再修改原生材质，染色由独立全局填充层承担",
  "sliderMapping": {
    "userRangePercent": [
      0,
      100
    ],
    "actualRangePercent": [
      20,
      80
    ],
    "actualFromUser": "actualPercent = 20 + userPercent * 0.6",
    "userFromActual": "userPercent = (actualPercent - 20) / 0.6",
    "alphaFromUser": "alpha = 0.2 + userPercent * 0.006",
    "defaultLight": {
      "actualPercent": 60,
      "userPercent": 66.66666666666667
    },
    "defaultDark": {
      "actualPercent": 40,
      "userPercent": 33.333333333333336
    },
    "rounding": "显示可保留两位小数；内部保留精度，避免默认60%/40%被取整滑杆改变"
