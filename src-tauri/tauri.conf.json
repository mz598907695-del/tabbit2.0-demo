{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tabbit-2-demo",
  "version": "0.1.4",
  "identifier": "com.tabbit.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run capture:defaults && npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tabbit 2 Demo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 23
        },
        "hiddenTitle": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/wallpapers/official/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/personalized-home-2-0/asset/wallpapers/official/*.mp4": "wallpapers/official/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzN0JFMDgzRDg2NDRDOTEKUldTUlRHVFlnK0I3STkwZEt3NWc3dU1PSFovUVcyMDd4MElCcGVJUDR3MFdtYWVaYU9EaTVmRWMK",
      "endpoints": [
        "https://github.com/mz598907695-del/tabbit-demo-updates/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
